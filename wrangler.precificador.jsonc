{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "precificador-artisys-central",
  "main": "src/precificador-worker.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "PRECIFICADOR_ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "PAGAMENTOS_CENTRAL",
      "service": "pagamentos-artisys-central"
    }
  ]
}
