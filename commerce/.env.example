# Copie para .env em ambiente PRIVADO, sem versionar o arquivo.
# Gerar chave: openssl rand -base64 32
LICENSE_MASTER_KEY=
# Gere uma senha aleatória >=32 caracteres. Nunca reutilize ADMIN_TOKEN de outros sistemas.
COMMERCE_ADMIN_TOKEN=
PUBLIC_BASE_URL=http://127.0.0.1:8789
SHOPIFY_STORE_DOMAIN=85pits-mq.myshopify.com
# Necessário habilitar uma integração Shopify própria; não é o token da conexão ChatGPT.
SHOPIFY_CLIENT_SECRET=
# Todos os conectores são OPT-IN. Ausência = waiting_configuration; sem envio externo.
MERCADOLIVRE_BRIDGE_SECRET=
MERCADOLIVRE_SELLER_ID=
PAYMENTS_BRIDGE_SECRET=
# Mapeamento productId da Central de Pagamentos -> SKU ArtiSys (JSON privado)
PAYMENTS_PRODUCT_SKUS_JSON={}
PRODUCT_CONNECTORS_JSON={}
CRM_CONNECTOR_JSON=
MAIL_CONNECTOR_JSON=
