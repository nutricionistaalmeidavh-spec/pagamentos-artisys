# Pagamento ArtiSys: variaveis de exemplo; nunca publique credenciais.
HOST=127.0.0.1
PORT=3080
DB_PATH=./data/payments.sqlite
RELEASES_DIR=./data/releases
PUBLIC_BASE_URL=https://pagamentos.example.com
PUBLIC_ORIGINS=https://artisys.dev,https://www.artisys.dev
# Gere uma chave com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
# Opt-in: use somente quando desejar Pix com confirmacao manual.
MANUAL_PIX_KEY=
# Opt-in: keys exclusivas, diferentes das chaves do Obra na Mao.
ASAAS_API_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
CONNECTOR_ALLOWED_ORIGINS=
PRODUCT_CONNECTORS_JSON={}
