{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pagamentos-artisys-central",
  "main": "src/cloudflare-worker.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "PAGAMENTO_ARTISYS_ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "PAGAMENTO_ARTISYS_DB",
      "database_name": "pagamento-artisys-central-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PAGAMENTO_ARTISYS_ARQUIVOS"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
